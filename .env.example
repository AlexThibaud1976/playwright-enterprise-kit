# ────────────────────────────────────────────────────────────────────────────
# Playwright Enterprise Kit - Environment variables
#
# Copy this file: cp .env.example .env
# DO NOT commit .env to the repository (it is in .gitignore)
# ────────────────────────────────────────────────────────────────────────────

# ── Application ──────────────────────────────────────────────────────────────
BASE_URL=http://localhost:3000

# ── Playwright ───────────────────────────────────────────────────────────────
HEADLESS=false
TEST_TIMEOUT=60000

# ── Integration selection (all optional) ─────────────────────────────────────
# Without any of the variables below the kit runs fully standalone: local
# browsers, HTML + JUnit + JSON reports, run-result.json. Every integration
# switches on by itself when its credentials are present ('auto').
# Check what is active with: npm run pek:doctor   - Docs: docs/integrations.md
# PEK_GRID=auto                 # auto | local | browserstack | lambdatest | remote
# PEK_TEST_MANAGEMENT=auto      # auto | none | xray,zephyr-scale,testrail,qase
# PEK_PUBLISHERS=auto           # auto | none | github-summary,confluence,slack,teams,webhook
# PEK_PLUGINS=                  # your own providers, e.g. ./integrations/custom/my-tool.js

# ── Jira ─────────────────────────────────────────────────────────────────────
JIRA_URL=https://yourcompany.atlassian.net
JIRA_USER=your.email@example.com
JIRA_API_TOKEN=your_jira_api_token
JIRA_PROJECT_KEY=MYPROJECT

# ── Xray Cloud ───────────────────────────────────────────────────────────────
XRAY_CLIENT_ID=your_xray_client_id
XRAY_CLIENT_SECRET=your_xray_client_secret
XRAY_ENDPOINT=xray.cloud.getxray.app

# ── Jira custom fields (optional) ───────────────────────────────────────────
# Retrieve IDs via Jira admin: Settings > Issues > Custom fields
# Format : customfield_XXXXX
# JIRA_CUSTOM_FIELD_OS=customfield_10100
# JIRA_CUSTOM_FIELD_OS_VERSION=customfield_10101
# JIRA_CUSTOM_FIELD_BROWSER=customfield_10102
# JIRA_CUSTOM_FIELD_BROWSER_VERSION=customfield_10103
# JIRA_CUSTOM_FIELD_TEST_SCOPE=customfield_10104

# ── Confluence (optional) ────────────────────────────────────────────────────
# CONFLUENCE_URL=https://yourcompany.atlassian.net/wiki
# CONFLUENCE_USER=your.email@example.com
# CONFLUENCE_API_TOKEN=your_confluence_api_token
# CONFLUENCE_SPACE_KEY=QA
# CONFLUENCE_PAGE_TITLE=Test Execution Dashboard
# CONFLUENCE_PARENT_PAGE_ID=

# ── Test users ────────────────────────────────────────────────────────────────
# TEST_USER_EMAIL=test@example.com
# TEST_USER_PASSWORD=password123

# ════════════════════════════════════════════════════════════════════════════
# Other integrations (all optional) - see docs/integrations.md
# ════════════════════════════════════════════════════════════════════════════

# ── Xray (Node publisher: npm run pek:publish) ──────────────────────────────
# XRAY_TEST_PLAN_KEY=MYPROJECT-100

# ── LambdaTest grid (npm run test:grid) ─────────────────────────────────────
# LT_USERNAME=your_lambdatest_username
# LT_ACCESS_KEY=your_lambdatest_access_key
# LT_PLATFORM=Windows 11          # e.g. "Windows 10", "macOS Sonoma"
# LT_BROWSER=Chrome               # Chrome | MicrosoftEdge | pw-chromium | pw-firefox | pw-webkit
# LT_BROWSER_VERSION=latest
# LT_BUILD_NAME=
# LT_PROJECT_NAME=My Project

# ── Remote Playwright server (playwright run-server, Docker, Browserless...) ─
# PEK_WS_ENDPOINT=ws://localhost:3000/
# PEK_WS_HEADERS={"Authorization":"Bearer xxx"}

# ── TestRail ─────────────────────────────────────────────────────────────────
# TESTRAIL_URL=https://yourcompany.testrail.io
# TESTRAIL_USER=your.email@example.com
# TESTRAIL_API_KEY=your_testrail_api_key
# TESTRAIL_PROJECT_ID=1
# TESTRAIL_SUITE_ID=              # required for multi-suite projects
# TESTRAIL_RUN_ID=                # reuse an existing run instead of creating one
# TESTRAIL_CLOSE_RUN=false

# ── Qase ─────────────────────────────────────────────────────────────────────
# QASE_API_TOKEN=your_qase_token
# QASE_PROJECT_CODE=DEMO
# QASE_RUN_ID=                    # reuse an existing run
# QASE_COMPLETE_RUN=true

# ── Zephyr Scale Cloud ───────────────────────────────────────────────────────
# ZEPHYR_API_TOKEN=your_zephyr_scale_token
# ZEPHYR_PROJECT_KEY=MYPROJECT
# ZEPHYR_BASE_URL=https://api.zephyrscale.smartbear.com/v2   # EU: https://eu.api.zephyrscale.smartbear.com/v2
# ZEPHYR_AUTO_CREATE_TEST_CASES=true

# ── Slack / Microsoft Teams ──────────────────────────────────────────────────
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ
# SLACK_NOTIFY_ON=all             # all | failure
# TEAMS_WEBHOOK_URL=https://prod-00.westeurope.logic.azure.com/workflows/...
# TEAMS_NOTIFY_ON=all             # all | failure

# ── Generic webhook (n8n, Zapier, Make, in-house dashboard...) ───────────────
# PEK_WEBHOOK_URL=https://example.com/hooks/playwright
# PEK_WEBHOOK_TOKEN=              # sent as Authorization: Bearer
# PEK_WEBHOOK_SECRET=             # HMAC-SHA256 signature in X-PEK-Signature
